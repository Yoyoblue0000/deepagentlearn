# ---------- 🔴 密钥（绝对不进库）----------
.env
.env.*
!.env.example

# ---------- 依赖 / 虚拟环境（占 99% 体积）----------
.venv/
venv/
node_modules/

# ---------- Python 生成物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---------- 测试 / 工具缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.agentseek/cache/

# ---------- 教材（clone 来的参考仓库，不属于我的产出）----------
refer/

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log

# 注意：uv.lock **要提交** —— 它锁定依赖版本，是复现环境的关键
