# 行尾规则：仓库内统一 LF，检出时不因平台产生噪音 diff
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.gitignore text eol=lf

# Windows 脚本保持 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制，别动
*.png     binary
*.jpg     binary
*.ico     binary
*.pdf     binary
